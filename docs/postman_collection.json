    "name": "SystemDesign API - CRUD",
    "description": "Coleccion CRUD para la API de usuarios, roles y datos de usuario.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "roleId",
      "value": "1"
    },
    {
      "key": "userDataId",
      "value": "1"
    },
    {
      "key": "userId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Roles",
      "item": [
        {
          "name": "Listar roles",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/roles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "roles"]
            }
          }
        },
        {
          "name": "Obtener rol por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/roles/{{roleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "roles", "{{roleId}}"]
            }
          }
        },
        {
          "name": "Crear rol",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.id) pm.collectionVariables.set('roleId', body.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Rol de administrador\",\n  \"roleName\": \"ROLE_ADMIN\",\n  \"users\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/roles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "roles"]
            }
          }
        },
        {
          "name": "Actualizar rol",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Rol de administrador actualizado\",\n  \"roleName\": \"ROLE_ADMIN\",\n  \"users\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/roles/{{roleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "roles", "{{roleId}}"]
            }
          }
        },
        {
          "name": "Eliminar rol",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/roles/{{roleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "roles", "{{roleId}}"]
            }
          }
        }
      ]
    },
