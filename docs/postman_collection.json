          }
        },
        {
          "name": "Crear bloqueo por Usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.id) pm.collectionVariables.set('blacklistRuleId', body.id);",
                  "pm.test('User blacklist rule created with 201 Created', function () {",
