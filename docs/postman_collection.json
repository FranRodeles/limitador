        {
          "name": "Crear bloqueo de IP individual (/32)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.id) pm.collectionVariables.set('blacklistRuleId', body.id);",
                  "pm.test('Rule created with 201 Created', function () {",
