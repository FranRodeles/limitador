          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ruleType\": \"IP_CIDR\",\n  \"targetValue\": \"{{blockedIpv4}}/32\",\n  \"reason\": \"Bloqueo de IP individual por intentos sospechosos\",\n  \"active\": true,\n  \"expiresAt\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/blacklist",
              "host": ["{{baseUrl}}"],
              "path": ["api", "blacklist"]
